msgid "Menagerie"
msgstr "Menagerie"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: menagerie.php
msgid "https://wilcosky.com"
msgstr "https://wilcosky.com"

#. Description of the plugin
#: menagerie.php
msgid "Optional WebP/AVIF upload conversion, JPEG companions, picture/OG fallback, and bulk library conversion for WordPress 7.1+."
msgstr "可选的 WebP/AVIF 上传转换、JPEG 配套、picture/OG 回退以及媒体库批量转换，适用于 WordPress 7.1+。"

#. Author of the plugin
#: menagerie.php
msgid "Billy Wilcosky"
msgstr "Billy Wilcosky"

#: includes/Admin/ImageConverterAjax.php:42
#: includes/Admin/ImageConverterAjax.php:86
