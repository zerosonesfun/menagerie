msgstr "https://wilcosky.com"

#. Description of the plugin
#: menagerie.php
msgid "Optional WebP/AVIF upload conversion, JPEG companions, picture/OG fallback, and bulk library conversion for WordPress 7.1+."
msgstr "Conversión opcional de subidas a WebP/AVIF, compañeros JPEG, fallback picture/OG y conversión masiva de la biblioteca para WordPress 7.1+."

#. Author of the plugin
#: menagerie.php
msgid "Billy Wilcosky"
msgstr "Billy Wilcosky"

